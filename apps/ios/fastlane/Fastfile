BETA_APP_IDENTIFIER = "ai.openclaw.client.J76B47MZ6V"

AIES_DEVELOPMENT_PROFILE_SPECS = [
  { target: "main", bundle_id: BETA_APP_IDENTIFIER },
  { target: "share", bundle_id: "#{BETA_APP_IDENTIFIER}.share" },
  { target: "activity_widget", bundle_id: "#{BETA_APP_IDENTIFIER}.activitywidget" },
  { target: "watch_app", bundle_id: "#{BETA_APP_IDENTIFIER}.watchkitapp" },
  { target: "watch_extension", bundle_id: "#{BETA_APP_IDENTIFIER}.watchkitapp.extension" }
].freeze

def load_env_file(path)
  return unless File.exist?(path)

  File.foreach(path) do |line|
    stripped = line.strip
    next if stripped.empty? || stripped.start_with?("#")

    key, value = stripped.split("=", 2)
    next if key.nil? || key.empty? || value.nil?

    ENV[key] = value if ENV[key].nil? || ENV[key].strip.empty?
  end
end

def env_present?(value)
  !value.nil? && !value.strip.empty?
end

def clear_empty_env_var(key)
  return unless ENV.key?(key)
  ENV.delete(key) unless env_present?(ENV[key])
end

def screenshot_upload_requested?
  ENV["DELIVER_SCREENSHOTS"] == "1"
end

def screenshot_paths
  Dir[File.join(__dir__, "screenshots", "**", "*.png")]
end

def maybe_decode_hex_keychain_secret(value)
  return value unless env_present?(value)

  candidate = value.strip
  return candidate unless candidate.match?(/\A[0-9a-fA-F]+\z/) && candidate.length.even?

  begin
    decoded = [candidate].pack("H*")
    return candidate unless decoded.valid_encoding?

    # `security find-generic-password -w` can return hex when the stored secret
    # includes newlines/non-printable bytes (like PEM files).
    beginPemMarker = %w[BEGIN PRIVATE KEY].join(" ") # pragma: allowlist secret
    endPemMarker = %w[END PRIVATE KEY].join(" ")
    if decoded.include?(beginPemMarker) || decoded.include?(endPemMarker)
      UI.message("Decoded hex-encoded ASC key content from Keychain.")
      return decoded
    end
  rescue StandardError
    return candidate
  end

  candidate
end

def read_asc_key_content_from_keychain
  service = ENV["ASC_KEYCHAIN_SERVICE"]
  service = "openclaw-asc-key" unless env_present?(service)

  account = ENV["ASC_KEYCHAIN_ACCOUNT"]
  account = ENV["USER"] unless env_present?(account)
  account = ENV["LOGNAME"] unless env_present?(account)
  return nil unless env_present?(account)

  begin
    stdout, _stderr, status = Open3.capture3(
      "security",
      "find-generic-password",
      "-s",
      service,
      "-a",
      account,
      "-w"
    )

    return nil unless status.success?

    key_content = stdout.to_s.strip
    key_content = maybe_decode_hex_keychain_secret(key_content)
    return nil unless env_present?(key_content)

    UI.message("Loaded ASC key content from Keychain service '#{service}' (account '#{account}').")
    key_content
  rescue Errno::ENOENT
    nil
  end
end

def repo_root
  File.expand_path("../../..", __dir__)
end

def ios_root
  File.expand_path("..", __dir__)
end

def read_ios_version_metadata
  script_path = File.join(repo_root, "scripts", "ios-version.ts")
  stdout, stderr, status = Open3.capture3(
    "node",
    "--import",
    "tsx",
    script_path,
    "--json",
    chdir: repo_root
  )

  unless status.success?
    detail = stderr.to_s.strip
    detail = stdout.to_s.strip if detail.empty?
    UI.user_error!("Failed to read iOS version metadata: #{detail}")
  end

  parsed = JSON.parse(stdout)
  version = parsed["canonicalVersion"].to_s.strip
  short_version = parsed["marketingVersion"].to_s.strip
  if !env_present?(version) || !env_present?(short_version)
    UI.user_error!("iOS version helper returned incomplete metadata.")
  end

  {
    short_version: short_version,
    version: version
  }
rescue JSON::ParserError => e
  UI.user_error!("Invalid JSON from iOS version helper: #{e.message}")
end

def sync_ios_versioning!
  script_path = File.join(repo_root, "scripts", "ios-sync-versioning.ts")
  stdout, stderr, status = Open3.capture3(
    "node",
    "--import",
    "tsx",
    script_path,
    "--check",
    chdir: repo_root
  )
  return if status.success?

  detail = stderr.to_s.strip
  detail = stdout.to_s.strip if detail.empty?
  UI.user_error!("iOS versioning artifacts are stale. Run `pnpm ios:version:sync`.\n#{detail}")
end

def shell_join(parts)
  Shellwords.join(parts.compact)
end

def monotonic_beta_build_number(latest_build:, minimum_build_number: nil)
  minimum = nil
  if env_present?(minimum_build_number)
    value = minimum_build_number.to_s.strip
    unless value.match?(/\A[1-9]\d*\z/)
      raise ArgumentError, "minimum beta build number must be a positive integer"
    end
    minimum = value.to_i
  end

  [latest_build.to_i + 1, minimum].compact.max.to_s
end

def resolve_beta_build_number(api_key:, short_version:, minimum_build_number: nil)
  explicit = ENV["IOS_BETA_BUILD_NUMBER"]
  if env_present?(explicit)
    UI.user_error!("Invalid IOS_BETA_BUILD_NUMBER '#{explicit}'. Expected digits only.") unless explicit.match?(/\A\d+\z/)
    UI.message("Using explicit iOS beta build number #{explicit}.")
    return explicit
  end

  latest_build = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: BETA_APP_IDENTIFIER,
    version: short_version,
    initial_build_number: 0
  )
  begin
    next_build = monotonic_beta_build_number(
      latest_build: latest_build,
      minimum_build_number: minimum_build_number
    )
  rescue ArgumentError => e
    UI.user_error!("Invalid minimum iOS beta build number: #{e.message}.")
  end
  UI.message(
    "Resolved iOS beta build number #{next_build} for #{short_version} " \
    "(latest TestFlight build: #{latest_build}, minimum: #{minimum_build_number || 'none'})."
  )
  next_build
end

def beta_build_number_needs_asc_auth?
  explicit = ENV["IOS_BETA_BUILD_NUMBER"]
  !env_present?(explicit)
end

def prepare_beta_release!(version:, build_number:, team_id: nil, push_mode: nil)
  script_path = File.join(repo_root, "scripts", "ios-beta-prepare.sh")
  arguments = ["bash", script_path, "--build-number", build_number]
  arguments += ["--team-id", team_id] if env_present?(team_id)
  arguments += ["--push-mode", push_mode] if env_present?(push_mode)
  UI.message("Preparing iOS beta release #{version} (build #{build_number}).")
  sh(shell_join(arguments))

  beta_xcconfig = File.join(ios_root, "build", "BetaRelease.xcconfig")
  UI.user_error!("Missing beta xcconfig at #{beta_xcconfig}.") unless File.exist?(beta_xcconfig)

  ENV["XCODE_XCCONFIG_FILE"] = beta_xcconfig
  beta_xcconfig
end

def build_beta_release(context)
  version = context[:version]
  internal_distribution = context[:aies_internal] == true
  output_directory = internal_distribution ? context.fetch(:output_directory) : File.join("build", "beta")
  archive_name = internal_distribution ? "OpenClaw.xcarchive" : "OpenClaw-#{version}.xcarchive"
  output_name = internal_distribution ? "OpenClaw.ipa" : "OpenClaw-#{version}.ipa"
  archive_path = File.join(output_directory, archive_name)
  xcode_arguments = context[:xcode_arguments] || ["-allowProvisioningUpdates"]
  xcode_arguments += context.fetch(:provenance_arguments, [])
  export_options = { signingStyle: "automatic" }
  export_options[:teamID] = context[:team_id] if env_present?(context[:team_id])
  if internal_distribution
    export_options["method"] = "app-store-connect"
    export_options["manageAppVersionAndBuildNumber"] = false
    export_options["testFlightInternalTestingOnly"] = true
  end

  build_app(
    project: "OpenClaw.xcodeproj",
    scheme: "OpenClaw",
    configuration: "Release",
    export_method: "app-store",
    clean: true,
    skip_profile_detection: true,
    build_path: output_directory,
    archive_path: archive_path,
    output_directory: output_directory,
    output_name: output_name,
    include_symbols: true,
    xcargs: shell_join(xcode_arguments),
    export_options: export_options
  )

  {
    archive_path: archive_path,
    build_number: context[:build_number],
    ipa_path: lane_context[SharedValues::IPA_OUTPUT_PATH],
    short_version: context[:short_version],
    testflight_internal_testing_only: internal_distribution,
    version: version
  }
end

def aies_export_options(context)
  export_options = {
    signingStyle: "automatic",
    manageAppVersionAndBuildNumber: false,
    testFlightInternalTestingOnly: true
  }
  export_options[:teamID] = context[:team_id] if env_present?(context[:team_id])
  export_options
end

def aies_archive_build_options(context, archive_path)
  xcode_arguments = context.fetch(:archive_xcode_arguments, []) +
    context.fetch(:provenance_arguments, []) +
    context.fetch(:archive_signing_arguments, [])
  {
    project: File.join(ios_root, "OpenClaw.xcodeproj"),
    scheme: "OpenClaw",
    configuration: "Release",
    clean: true,
    skip_profile_detection: true,
    skip_package_ipa: true,
    build_path: context.fetch(:output_directory),
    archive_path: archive_path,
    include_symbols: true,
    xcargs: shell_join(xcode_arguments)
  }
end

def import_aies_reusable_development_identity!(release_context)
  runner_temp = File.expand_path(required_env!("RUNNER_TEMP"))
  expected_path = File.join(runner_temp, "aies-apple-development-identity.p12")
  p12_path = File.expand_path(required_env!("AIES_DEVELOPMENT_CERTIFICATE_PATH"))
  UI.user_error!("Apple Development PKCS#12 must use the bounded runner path.") unless p12_path == expected_path
  UI.user_error!("Apple Development PKCS#12 must be a regular private file.") unless File.file?(p12_path) && !File.symlink?(p12_path)
  file_stat = File.stat(p12_path)
  unless file_stat.size.positive? && file_stat.size <= 1_500_000 && (file_stat.mode & 0o077).zero?
    UI.user_error!("Apple Development PKCS#12 size or permissions are invalid.")
  end

  password = ENV["AIES_DEVELOPMENT_CERTIFICATE_PASSWORD"]
  unless password.is_a?(String) && !password.empty? && password.bytesize <= 1_024
    UI.user_error!("Protected Apple Development PKCS#12 password is unavailable.")
  end
  expected_sha256 = required_env!("AIES_DEVELOPMENT_CERTIFICATE_SHA256").downcase
  unless expected_sha256.match?(/\A[0-9a-f]{64}\z/)
    UI.user_error!("AIES_DEVELOPMENT_CERTIFICATE_SHA256 must be lowercase SHA-256 hex.")
  end

  begin
    pkcs12 = OpenSSL::PKCS12.new(File.binread(p12_path), password)
  rescue OpenSSL::PKCS12::PKCS12Error
    UI.user_error!("Protected Apple Development PKCS#12 could not be decoded.")
  end
  certificate = pkcs12.certificate
  private_key = pkcs12.key
  UI.user_error!("Protected PKCS#12 has no leaf certificate.") if certificate.nil?
  UI.user_error!("Protected PKCS#12 has no private key.") if private_key.nil?
  unless certificate.check_private_key(private_key)
    UI.user_error!("Protected PKCS#12 private key does not match its certificate.")
  end

  actual_sha256 = Digest::SHA256.hexdigest(certificate.to_der)
  actual_sha1 = Digest::SHA1.hexdigest(certificate.to_der).upcase
  unless actual_sha256 == expected_sha256
    UI.user_error!("Protected Apple Development identity fingerprint mismatch.")
  end
  subject = certificate.subject.to_a.to_h { |name, value, _type| [name, value] }
  common_name = subject["CN"].to_s
  team_id = subject["OU"].to_s
  unless common_name.start_with?("Apple Development:")
    UI.user_error!("Protected identity is not an Apple Development certificate.")
  end
  unless team_id == release_context.fetch(:team_id)
    UI.user_error!("Protected Apple Development identity belongs to another Team.")
  end
  unless certificate.issuer.to_s.include?("Apple Worldwide Developer Relations")
    UI.user_error!("Protected Apple Development identity has an unexpected issuer.")
  end
  now = Time.now
  unless certificate.not_before <= now && certificate.not_after > now + 86_400
    UI.user_error!("Protected Apple Development identity is not currently usable for at least 24 hours.")
  end

  keychain_name = required_env!("MATCH_KEYCHAIN_NAME")
  expected_keychain_name = required_env!("FL_SETUP_CI_KEYCHAIN_NAME")
  unless keychain_name == expected_keychain_name &&
      keychain_name.match?(/\Aaies_development_[0-9]+_[0-9]+\z/)
    UI.user_error!("Fastlane setup_ci did not create the bounded AIES development keychain.")
  end
  keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
  import_certificate(
    certificate_path: p12_path,
    certificate_password: password,
    keychain_name: keychain_name,
    keychain_password: keychain_password,
    log_output: false
  )
  keychain_path = File.expand_path(FastlaneCore::Helper.keychain_path(keychain_name))
  expected_keychain_path = File.expand_path(
    File.join(Dir.home, "Library", "Keychains", "#{keychain_name}-db")
  )
  unless keychain_path == expected_keychain_path && File.file?(keychain_path)
    UI.user_error!("Fastlane setup_ci development keychain path is invalid.")
  end
  identity_output, identity_error, identity_status = Open3.capture3(
    "security", "find-identity", "-v", "-p", "codesigning", keychain_path
  )
  unless identity_status.success?
    UI.user_error!("Unable to verify imported Apple Development identity: #{identity_error.to_s.strip}")
  end
  identity_hashes = identity_output.scan(
    /^\s*\d+\)\s+([0-9A-F]{40})\s+"/i
  ).flatten.map(&:upcase)
  unless identity_hashes == [actual_sha1]
    UI.user_error!("Imported Apple Development private-key identity set is not exact.")
  end

  Dir.mktmpdir("aies-codesign-probe-", runner_temp) do |directory|
    probe = File.join(directory, "true")
    FileUtils.cp("/usr/bin/true", probe)
    _probe_output, _probe_error, probe_status = Open3.capture3(
      "/usr/bin/codesign",
      "--force",
      "--sign", actual_sha1,
      "--keychain", keychain_path,
      "--timestamp=none",
      probe
    )
    UI.user_error!("Imported Apple Development private key failed a bounded signing probe.") unless probe_status.success?
  end

  receipt = File.join(
    release_context.fetch(:output_directory),
    "OpenClaw-development-signing-import.json"
  )
  FileUtils.mkdir_p(File.dirname(receipt))
  File.write(receipt, JSON.pretty_generate({
    schema: "aies.apple-development-identity-import.v1",
    status: "reusable_private_key_identity_imported",
    certificate_sha1: actual_sha1.downcase,
    certificate_sha256: actual_sha256,
    certificate_serial: certificate.serial.to_s(16).downcase,
    certificate_common_name: common_name,
    certificate_not_before: certificate.not_before.utc.iso8601,
    certificate_not_after: certificate.not_after.utc.iso8601,
    team_id: team_id,
    private_key_matches_certificate: true,
    private_key_use_verified: true,
    keychain_valid_identity_count: identity_hashes.length
  }) + "\n")

  {
    certificate_sha1: actual_sha1,
    certificate_sha256: actual_sha256,
    receipt: receipt
  }
ensure
  ENV.delete("AIES_DEVELOPMENT_CERTIFICATE_PASSWORD")
  FileUtils.rm_f(expected_path) if defined?(expected_path) && p12_path == expected_path
end

def aies_profile_certificate_der(raw_certificate)
  return raw_certificate if raw_certificate.is_a?(String)
  return raw_certificate.string if raw_certificate.respond_to?(:string)

  UI.user_error!("Development profile contains an unreadable certificate value.")
end

def aies_xcode_development_profile_root
  File.expand_path(
    File.join(
      Dir.home,
      "Library",
      "Developer",
      "Xcode",
      "UserData",
      "Provisioning Profiles"
    )
  )
end

def assert_empty_aies_profile_caches!
  roots = [
    aies_xcode_development_profile_root,
    File.expand_path(
      File.join(Dir.home, "Library", "MobileDevice", "Provisioning Profiles")
    )
  ]
  roots.each do |root|
    UI.user_error!("Refusing a symlinked provisioning profile cache.") if File.symlink?(root)
  end
  present = roots.flat_map do |root|
    Dir.glob(File.join(root, "*.{mobileprovision,provisionprofile}"))
  end
  unless present.empty?
    UI.user_error!("Ephemeral runner profile caches must be empty before governed installation.")
  end
end

def validate_aies_development_profile!(profile, parsed, release_context, expected_sha256)
  bundle_id = profile.fetch(:bundle_id)
  target = profile.fetch(:target)
  remote = profile.fetch(:remote)
  UI.user_error!("Development profile resource ID is malformed for #{target}.") unless remote.id.to_s.match?(/\A[A-Za-z0-9-]{1,128}\z/)
  unless remote.profile_type == Spaceship::ConnectAPI::Profile::ProfileType::IOS_APP_DEVELOPMENT
    UI.user_error!("Development profile type is invalid for #{target}.")
  end
  unless remote.profile_state == Spaceship::ConnectAPI::Profile::ProfileState::ACTIVE
    UI.user_error!("Development profile is not ACTIVE for #{target}.")
  end

  uuid = parsed["UUID"].to_s
  name = parsed["Name"].to_s
  unless uuid.match?(/\A[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}\z/) &&
      remote.uuid.to_s.casecmp?(uuid)
    UI.user_error!("Development profile UUID is invalid for #{target}.")
  end
  unless name.bytesize.between?(1, 256) && remote.name.to_s == name
    UI.user_error!("Development profile name is invalid for #{target}.")
  end

  expiration_value = parsed["ExpirationDate"]
  expiration = if expiration_value.respond_to?(:to_time)
                 expiration_value.to_time
               else
                 Time.parse(expiration_value.to_s)
               end
  expiration = expiration.utc
  unless expiration > Time.now.utc + 86_400
    UI.user_error!("Development profile expires too soon for #{target}.")
  end

  team_id = release_context.fetch(:team_id)
  unless parsed["TeamIdentifier"] == [team_id] &&
      parsed["ApplicationIdentifierPrefix"] == [team_id]
    UI.user_error!("Development profile Team identity is invalid for #{target}.")
  end
  platforms = parsed["Platform"]
  unless platforms.is_a?(Array) && platforms.include?("iOS") &&
      platforms.all? { |value| value.is_a?(String) }
    UI.user_error!("Development profile platform is invalid for #{target}.")
  end

  entitlements = parsed["Entitlements"]
  UI.user_error!("Development profile entitlements are malformed for #{target}.") unless entitlements.is_a?(Hash)
  application_identifier = "#{team_id}.#{bundle_id}"
  unless entitlements["application-identifier"] == application_identifier &&
      entitlements["com.apple.developer.team-identifier"] == team_id &&
      entitlements["get-task-allow"] == true
    UI.user_error!("Development profile application identity is invalid for #{target}.")
  end
  expected_aps = bundle_id == release_context.fetch(:main_bundle_id) ? "development" : nil
  unless entitlements["aps-environment"] == expected_aps
    UI.user_error!("Development profile APS entitlement is invalid for #{target}.")
  end

  devices = parsed["ProvisionedDevices"]
  unless devices.is_a?(Array) && devices.length.between?(1, 1_000) &&
      devices.all? { |value| value.is_a?(String) && value.bytesize.between?(1, 256) } &&
      parsed["ProvisionsAllDevices"] != true
    UI.user_error!("Development profile device scope is invalid for #{target}.")
  end
  certificates = parsed["DeveloperCertificates"]
  unless certificates.is_a?(Array) && certificates.length.between?(1, 50)
    UI.user_error!("Development profile certificate set is missing for #{target}.")
  end
  certificate_sha256 = certificates.map do |certificate|
    Digest::SHA256.hexdigest(aies_profile_certificate_der(certificate))
  end.sort
  unless certificate_sha256.uniq == certificate_sha256 &&
      certificate_sha256.include?(expected_sha256)
    UI.user_error!("Development profile does not authorize the governed identity for #{target}.")
  end

  {
    apple_resource_id: remote.id.to_s,
    bundle_id: bundle_id,
    target: target,
    profile_uuid: uuid.downcase,
    profile_name: name,
    profile_expiration_at: expiration.iso8601,
    profile_type: remote.profile_type,
    profile_state: remote.profile_state,
    application_identifier: application_identifier,
    get_task_allow: true,
    aps_environment: expected_aps,
    provisioned_device_count: devices.length,
    developer_certificate_sha256: certificate_sha256,
    xcode_managed: parsed["IsXcodeManaged"] == true
  }
rescue ArgumentError => e
  UI.user_error!("Development profile metadata is malformed for #{target}: #{e.message}")
end

def fetch_install_aies_reusable_development_profiles!(release_context, expected_sha256)
  runner_temp = File.expand_path(required_env!("RUNNER_TEMP"))
  download_directory = File.join(runner_temp, "aies-development-profiles")
  cleanup_journal = File.join(runner_temp, "aies-development-profile-cleanup.json")
  UI.user_error!("Development profile staging path already exists.") if File.exist?(download_directory)
  UI.user_error!("Development profile cleanup journal already exists.") if File.exist?(cleanup_journal) || File.symlink?(cleanup_journal)
  assert_empty_aies_profile_caches!
  FileUtils.mkdir(download_directory, mode: 0o700)

  validated = []
  installed_paths = []
  begin
    development_profiles = Spaceship::ConnectAPI::Profile.all(
      filter: {
        profileType: Spaceship::ConnectAPI::Profile::ProfileType::IOS_APP_DEVELOPMENT
      },
      includes: "bundleId"
    )
    AIES_DEVELOPMENT_PROFILE_SPECS.each do |spec|
      bundle_records = Spaceship::ConnectAPI::BundleId.all(
        filter: { identifier: spec.fetch(:bundle_id) }
      ).select { |record| record.identifier == spec.fetch(:bundle_id) }
      unless bundle_records.length == 1
        UI.user_error!("Expected one Apple Bundle ID resource for #{spec.fetch(:target)}; found #{bundle_records.length}.")
      end
      bundle_record = bundle_records.first
      unless bundle_record.id.to_s.match?(/\A[A-Za-z0-9-]{1,128}\z/)
        UI.user_error!("Apple Bundle ID resource is malformed for #{spec.fetch(:target)}.")
      end

      candidates = development_profiles.select do |profile|
        profile.bundle_id&.identifier == spec.fetch(:bundle_id) &&
          profile.bundle_id&.id.to_s == bundle_record.id.to_s &&
          profile.profile_state == Spaceship::ConnectAPI::Profile::ProfileState::ACTIVE
      end
      matches = []
      candidates.each_with_index do |remote_profile, index|
        encoded = remote_profile.profile_content.to_s.gsub(/\s+/, "")
        UI.user_error!("Development profile content is missing or oversized for #{spec.fetch(:target)}.") unless encoded.bytesize.between?(1, 7_000_000)
        begin
          content = Base64.strict_decode64(encoded)
        rescue ArgumentError
          UI.user_error!("Development profile content is not valid base64 for #{spec.fetch(:target)}.")
        end
        UI.user_error!("Decoded development profile is missing or oversized for #{spec.fetch(:target)}.") unless content.bytesize.between?(1, 5_000_000)
        path = File.join(download_directory, "#{spec.fetch(:target)}-#{index}.mobileprovision")
        File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |handle|
          handle.binmode
          handle.write(content)
        end
        parsed = FastlaneCore::ProvisioningProfile.parse(path)
        certificate_values = parsed["DeveloperCertificates"]
        next unless certificate_values.is_a?(Array)
        fingerprints = certificate_values.map do |certificate|
          Digest::SHA256.hexdigest(aies_profile_certificate_der(certificate))
        end
        next unless fingerprints.include?(expected_sha256)

        summary = validate_aies_development_profile!(
          spec.merge(remote: remote_profile),
          parsed,
          release_context,
          expected_sha256
        )
        summary[:source_path] = path
        summary[:source_sha256] = Digest::SHA256.file(path).hexdigest
        summary[:bundle_resource_id] = bundle_record.id.to_s
        matches << summary
      end
      unless matches.length == 1
        UI.user_error!("Expected one ACTIVE governed development profile for #{spec.fetch(:target)}; found #{matches.length}.")
      end
      validated << matches.first
    end

    journal_payload = {
      schema: "aies.apple-development-profile-cleanup.v1",
      profile_uuids: validated.map { |item| item.fetch(:profile_uuid) }.sort
    }
    File.open(cleanup_journal, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |handle|
      handle.write(JSON.generate(journal_payload) + "\n")
    end

    profile_root = aies_xcode_development_profile_root
    UI.user_error!("Refusing a symlinked Xcode profile cache.") if File.symlink?(profile_root)
    FileUtils.mkdir_p(profile_root, mode: 0o700)
    validated.each do |item|
      source_path = item.fetch(:source_path)
      expected_destination = File.join(
        profile_root,
        "#{item.fetch(:profile_uuid)}.mobileprovision"
      )
      if File.exist?(expected_destination) || File.symlink?(expected_destination)
        UI.user_error!("Refusing to overwrite an existing development profile installation.")
      end
      installed_path = File.expand_path(expected_destination)
      installed_paths << installed_path
      File.open(installed_path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |handle|
        handle.binmode
        handle.write(File.binread(source_path))
      end
      installed_parsed = FastlaneCore::ProvisioningProfile.parse(installed_path)
      unless File.file?(installed_path) && !File.symlink?(installed_path) &&
          Digest::SHA256.file(installed_path).hexdigest == item.fetch(:source_sha256) &&
          installed_parsed["UUID"].to_s.casecmp?(item.fetch(:profile_uuid))
        UI.user_error!("Installed development profile verification failed for #{item.fetch(:target)}.")
      end
    end

    receipt = File.join(
      release_context.fetch(:output_directory),
      "OpenClaw-development-profile-import.json"
    )
    FileUtils.mkdir_p(File.dirname(receipt))
    File.write(receipt, JSON.pretty_generate({
      schema: "aies.apple-development-profile-import.v1",
      status: "five_governed_profiles_installed_for_offline_archive",
      source_operation: "read_only_apple_profile_fetch",
      archive_allows_provisioning_updates: false,
      archive_receives_apple_authentication_arguments: false,
      team_id: release_context.fetch(:team_id),
      certificate_sha256: expected_sha256,
      profile_count: validated.length,
      profiles: validated.map do |item|
        item.reject { |key, _value| [:source_path].include?(key) }
      end.sort_by { |item| item.fetch(:bundle_id) }
    }) + "\n")

    {
      installed_paths: installed_paths,
      receipt: receipt
    }
  rescue StandardError
    remove_aies_installed_development_profiles!(installed_paths)
    raise
  ensure
    FileUtils.rm_rf(download_directory) if File.expand_path(download_directory).start_with?("#{runner_temp}#{File::SEPARATOR}")
  end
end

def remove_aies_installed_development_profiles!(paths)
  profile_root = aies_xcode_development_profile_root
  Array(paths).each do |raw_path|
    path = File.expand_path(raw_path.to_s)
    unless File.dirname(path) == profile_root &&
        File.basename(path).match?(/\A[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}\.mobileprovision\z/)
      UI.user_error!("Refusing to remove an unexpected development profile path.")
    end
    FileUtils.rm_f(path)
    UI.user_error!("Ephemeral development profile cleanup failed.") if File.exist?(path) || File.symlink?(path)
  end
  runner_temp = ENV["RUNNER_TEMP"]
  if env_present?(runner_temp)
    runner_temp = File.expand_path(runner_temp)
    journal = File.expand_path(
      File.join(runner_temp, "aies-development-profile-cleanup.json")
    )
    unless File.dirname(journal) == runner_temp &&
        File.basename(journal) == "aies-development-profile-cleanup.json"
      UI.user_error!("Refusing an unexpected development profile cleanup journal path.")
    end
    UI.user_error!("Refusing a symlinked development profile cleanup journal.") if File.symlink?(journal)
    FileUtils.rm_f(journal)
  end
end

def aies_export_build_options(context, archive_path, output_directory)
  {
    project: File.join(ios_root, "OpenClaw.xcodeproj"),
    scheme: "OpenClaw",
    configuration: "Release",
    export_method: "app-store",
    skip_profile_detection: true,
    skip_build_archive: true,
    archive_path: archive_path,
    output_directory: output_directory,
    output_name: "OpenClaw.ipa",
    include_symbols: true,
    xcargs: shell_join(context.fetch(:export_xcode_arguments)),
    export_options: aies_export_options(context)
  }
end

def build_aies_beta_archive(context)
  output_directory = context.fetch(:output_directory)
  archive_path = File.join(output_directory, "OpenClaw.xcarchive")
  build_app(**aies_archive_build_options(context, archive_path))
  UI.user_error!("Signed archive was not produced.") unless File.directory?(archive_path)

  {
    archive_path: archive_path,
    build_number: context[:build_number],
    short_version: context[:short_version],
    testflight_internal_testing_only: true,
    version: context[:version]
  }
end

def export_aies_beta_archive(context, build)
  staging_directory = File.join(context.fetch(:output_directory), "unverified-export")
  FileUtils.rm_rf(staging_directory)
  FileUtils.mkdir_p(staging_directory)
  build_app(
    **aies_export_build_options(
      context,
      build.fetch(:archive_path),
      staging_directory
    )
  )
  ipa_path = File.expand_path(lane_context[SharedValues::IPA_OUTPUT_PATH].to_s, ios_root)
  expected_ipa_path = File.join(File.expand_path(staging_directory, ios_root), "OpenClaw.ipa")
  UI.user_error!("Exported IPA escaped the bounded staging directory.") unless ipa_path == expected_ipa_path
  UI.user_error!("Signed IPA was not produced.") unless File.file?(ipa_path)
  build.merge(ipa_path: ipa_path, staging_directory: staging_directory)
end

def required_env!(key)
  value = ENV[key]
  UI.user_error!("Missing required #{key} for AIES internal TestFlight.") unless env_present?(value)
  value.strip
end

def require_matching_checkout!(expected_sha, expected_branch)
  sha, sha_error, sha_status = Open3.capture3("git", "rev-parse", "HEAD", chdir: repo_root)
  UI.user_error!("Unable to resolve checkout SHA: #{sha_error.to_s.strip}") unless sha_status.success?
  actual_sha = sha.strip.downcase
  UI.user_error!("AIES expected SHA must be a 40-character hexadecimal commit.") unless expected_sha.match?(/\A[0-9a-f]{40}\z/)
  UI.user_error!("Checkout SHA does not match AIES_EXPECTED_GIT_SHA.") unless actual_sha == expected_sha

  branch, branch_error, branch_status = Open3.capture3(
    "git",
    "branch",
    "--show-current",
    chdir: repo_root
  )
  UI.user_error!("Unable to resolve checkout branch: #{branch_error.to_s.strip}") unless branch_status.success?
  github_ref_name = ENV["GITHUB_REF_NAME"].to_s.strip
  github_ref_type = ENV["GITHUB_REF_TYPE"].to_s.strip
  UI.user_error!("AIES workflow must be dispatched from a branch ref.") unless github_ref_type == "branch"
  UI.user_error!("Workflow ref does not match AIES_EXPECTED_GIT_BRANCH.") unless github_ref_name == expected_branch
  # actions/checkout may leave an exact-SHA workflow in detached HEAD state.
  UI.user_error!("Checkout branch does not match AIES_EXPECTED_GIT_BRANCH.") unless branch.strip.empty? || branch.strip == expected_branch

  status, status_error, status_result = Open3.capture3(
    "git",
    "status",
    "--porcelain=v1",
    "--untracked-files=normal",
    chdir: repo_root
  )
  UI.user_error!("Unable to inspect checkout status: #{status_error.to_s.strip}") unless status_result.success?
  UI.user_error!("AIES TestFlight checkout must be clean before release preparation.") unless status.empty?
end

def prepare_aies_internal_context!
  UI.user_error!("AIES internal TestFlight lane is CI-only.") unless ENV["CI"] == "true" && ENV["GITHUB_ACTIONS"] == "true"
  UI.user_error!("AIES internal TestFlight environment is not enabled.") unless ENV["AIES_TESTFLIGHT_INTERNAL_ENABLED"] == "true"
  UI.user_error!("Internal-only dispatch confirmation is missing.") unless ENV["AIES_INTERNAL_ONLY_CONFIRMED"] == "true"
  unless required_env!("GITHUB_ACTOR") == "ScandalousSwede"
    UI.user_error!("AIES internal lane is restricted to Ethan's GitHub account.")
  end
  unless required_env!("GITHUB_TRIGGERING_ACTOR") == "ScandalousSwede"
    UI.user_error!("AIES internal lane reruns are restricted to Ethan's GitHub account.")
  end

  expected_sha = required_env!("AIES_EXPECTED_GIT_SHA").downcase
  expected_branch = required_env!("AIES_EXPECTED_GIT_BRANCH")
  UI.user_error!("AIES internal lane is restricted to the integrated RC1 branch.") unless expected_branch == "aies/ios-rc1-testflight"
  require_matching_checkout!(expected_sha, expected_branch)

  main_bundle_id = required_env!("ASC_APP_IDENTIFIER")
  UI.user_error!("AIES internal lane only supports #{BETA_APP_IDENTIFIER}.") unless main_bundle_id == BETA_APP_IDENTIFIER
  app_store_id = required_env!("ASC_APP_ID")
  UI.user_error!("ASC_APP_ID must contain digits only.") unless app_store_id.match?(/\A\d+\z/)
  team_id = required_env!("IOS_DEVELOPMENT_TEAM")
  UI.user_error!("IOS_DEVELOPMENT_TEAM must be a 10-character Apple Team ID.") unless team_id.match?(/\A[A-Z0-9]{10}\z/)
  required_env!("ASC_KEY_ID")
  required_env!("ASC_ISSUER_ID")
  key_path = required_env!("ASC_KEY_PATH")
  UI.user_error!("ASC_KEY_PATH does not point to a private runner file.") unless File.file?(key_path)
  runner_temp = File.expand_path(required_env!("RUNNER_TEMP"))
  expected_key_path = File.join(runner_temp, "aies-app-store-connect-key.p8")
  UI.user_error!("ASC_KEY_PATH must use the bounded runner key path.") unless File.expand_path(key_path) == expected_key_path
  output_directory = File.expand_path(required_env!("AIES_TESTFLIGHT_OUTPUT_DIR"))
  expected_output_directory = File.join(runner_temp, "openclaw-aies-testflight")
  UI.user_error!("AIES_TESTFLIGHT_OUTPUT_DIR must use the bounded runner output path.") unless output_directory == expected_output_directory
  expected_result_path = File.join(output_directory, "OpenClaw-TestFlight-delivery.json")
  UI.user_error!("AIES_TESTFLIGHT_RESULT_PATH must stay inside the bounded runner output path.") unless File.expand_path(required_env!("AIES_TESTFLIGHT_RESULT_PATH")) == expected_result_path

  %w[OPENCLAW_PUSH_RELAY_BASE_URL IOS_PUSH_RELAY_BASE_URL].each do |key|
    UI.user_error!("#{key} must be absent from the direct AIES lane.") if ENV.key?(key)
  end
  %w[OPENCLAW_APNS_PRIVATE_KEY_P8 OPENCLAW_APNS_PRIVATE_KEY_PATH].each do |key|
    UI.user_error!("Gateway APNs provider credentials must never enter the build lane (#{key}).") if env_present?(ENV[key])
  end
  if env_present?(ENV["IOS_BETA_BUILD_NUMBER"])
    UI.user_error!("AIES signed builds must use the ASC-backed monotonic build-number resolver.")
  end

  {
    app_store_id: app_store_id,
    expected_branch: expected_branch,
    expected_sha: expected_sha,
    internal_group: required_env!("AIES_INTERNAL_TESTER_GROUP"),
    main_bundle_id: main_bundle_id,
    output_directory: output_directory,
    team_id: team_id
  }
end

def aies_xcode_auth_arguments(key_path: nil, key_id: nil, issuer_id: nil)
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath",
    key_path || required_env!("ASC_KEY_PATH"),
    "-authenticationKeyID",
    key_id || required_env!("ASC_KEY_ID"),
    "-authenticationKeyIssuerID",
    issuer_id || required_env!("ASC_ISSUER_ID")
  ]
end

def aies_provenance_arguments(release_context)
  {
    "OPENCLAW_BUILD_GIT_SHA" => release_context[:expected_sha],
    "OPENCLAW_BUILD_GIT_BRANCH" => release_context[:expected_branch],
    "OPENCLAW_BUILD_TIMESTAMP" => required_env!("AIES_BUILD_TIMESTAMP"),
    "OPENCLAW_BUILD_XCODE_VERSION" => required_env!("AIES_XCODE_VERSION"),
    "OPENCLAW_BUILD_SWIFT_VERSION" => required_env!("AIES_SWIFT_VERSION"),
    "OPENCLAW_BUILD_SDK_VERSION" => required_env!("AIES_SDK_VERSION"),
    "OPENCLAW_BUILD_CONFIGURATION" => "Release",
    "OPENCLAW_BUILD_ARCHIVE_UUID" => required_env!("AIES_ARCHIVE_UUID"),
    "OPENCLAW_BUILD_APS_ENVIRONMENT_IF_SIGNED" => "production"
  }.map { |key, value| "#{key}=#{value}" }
end

def package_aies_archive_evidence!(build, release_context)
  output_directory = release_context[:output_directory]
  archive_path = File.expand_path(build[:archive_path], ios_root)
  archive_zip = File.join(output_directory, "OpenClaw.xcarchive.zip")
  dsym_zip = File.join(output_directory, "OpenClaw-dSYMs.zip")
  signing_report = File.join(output_directory, "OpenClaw-archive-signing-entitlements.json")
  build_manifest = File.join(output_directory, "OpenClaw-archive-manifest.json")
  dsym_path = File.join(archive_path, "dSYMs")

  UI.user_error!("Signed archive was not produced.") unless File.directory?(archive_path)
  UI.user_error!("Signed archive contains no dSYMs.") unless File.directory?(dsym_path) && !Dir[File.join(dsym_path, "*.dSYM")].empty?

  FileUtils.rm_f([archive_zip, dsym_zip, signing_report, build_manifest])
  sh(shell_join(["ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", archive_path, archive_zip]))
  sh(shell_join(["ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", dsym_path, dsym_zip]))

  verifier = File.join(ios_root, "Tools", "verify_aies_internal_signing.py")
  sh(shell_join([
    "python3", verifier,
    "--archive", archive_path,
    "--archive-only",
    "--output", signing_report,
    "--expected-main-bundle-id", release_context[:main_bundle_id],
    "--expected-team-id", release_context[:team_id],
    "--expected-git-sha", release_context[:expected_sha],
    "--expected-archive-uuid", required_env!("AIES_ARCHIVE_UUID")
  ]))

  manifest_writer = File.join(ios_root, "Tools", "write_build_manifest.py")
  sh(shell_join([
    "python3", manifest_writer,
    "--archive", archive_path,
    "--output", build_manifest,
    "--git-sha", release_context[:expected_sha],
    "--git-branch", release_context[:expected_branch],
    "--build-timestamp", required_env!("AIES_BUILD_TIMESTAMP"),
    "--xcode-version", required_env!("AIES_XCODE_VERSION"),
    "--swift-version", required_env!("AIES_SWIFT_VERSION"),
    "--sdk-version", required_env!("AIES_SDK_VERSION"),
    "--configuration", "Release",
    "--archive-uuid", required_env!("AIES_ARCHIVE_UUID"),
    "--archive-only",
    "--archive-zip", archive_zip,
    "--dsym-zip", dsym_zip,
    "--github-run-id", required_env!("GITHUB_RUN_ID")
  ]))

  {
    archive_path: archive_path,
    archive_zip: archive_zip,
    build_manifest: build_manifest,
    dsym_zip: dsym_zip,
    signing_report: signing_report
  }
end

def verify_aies_reusable_development_identity!(archive_evidence, release_context)
  expected_sha256 = required_env!("AIES_DEVELOPMENT_CERTIFICATE_SHA256").downcase
  unless expected_sha256.match?(/\A[0-9a-f]{64}\z/)
    UI.user_error!("AIES_DEVELOPMENT_CERTIFICATE_SHA256 must be lowercase SHA-256 hex.")
  end

  receipt = File.join(
    release_context[:output_directory],
    "OpenClaw-development-signing-identity.json"
  )
  verifier = File.join(ios_root, "Tools", "verify_aies_development_identity_reuse.py")
  FileUtils.rm_f(receipt)
  sh(shell_join([
    "python3", verifier,
    "--archive-signing-report", archive_evidence.fetch(:signing_report),
    "--profile-import-receipt", archive_evidence.fetch(:development_profile_receipt),
    "--expected-certificate-sha256", expected_sha256,
    "--expected-team-id", release_context.fetch(:team_id),
    "--expected-main-bundle-id", release_context.fetch(:main_bundle_id),
    "--output", receipt
  ]))
  UI.user_error!("Reusable Apple Development identity receipt was not produced.") unless File.file?(receipt)
  archive_evidence[:development_identity_receipt] = receipt
  receipt
end

def package_aies_internal_evidence!(build, release_context, archive_evidence)
  output_directory = release_context[:output_directory]
  archive_path = File.expand_path(build[:archive_path], ios_root)
  ipa_path = File.expand_path(build[:ipa_path], ios_root)
  staging_directory = File.expand_path(build.fetch(:staging_directory), ios_root)
  final_ipa = File.join(output_directory, "OpenClaw.ipa")
  final_signing_report = File.join(output_directory, "OpenClaw-signing-entitlements.json")
  final_build_manifest = File.join(output_directory, "OpenClaw-build-manifest.json")
  staged_signing_report = File.join(staging_directory, "OpenClaw-signing-entitlements.json")
  staged_build_manifest = File.join(staging_directory, "OpenClaw-build-manifest.json")

  UI.user_error!("Signed IPA was not produced.") unless File.file?(ipa_path)
  UI.user_error!("Signed archive evidence is incomplete.") unless [
    archive_evidence[:archive_zip],
    archive_evidence[:development_identity_receipt],
    archive_evidence[:development_profile_receipt],
    archive_evidence[:dsym_zip],
    archive_evidence[:signing_report],
    archive_evidence[:build_manifest]
  ].all? { |path| File.file?(path) }

  verifier = File.join(ios_root, "Tools", "verify_aies_internal_signing.py")
  sh(shell_join([
    "python3", verifier,
    "--archive", archive_path,
    "--ipa", ipa_path,
    "--output", staged_signing_report,
    "--expected-main-bundle-id", release_context[:main_bundle_id],
    "--expected-team-id", release_context[:team_id],
    "--expected-git-sha", release_context[:expected_sha],
    "--expected-archive-uuid", required_env!("AIES_ARCHIVE_UUID")
  ]))

  manifest_writer = File.join(ios_root, "Tools", "write_build_manifest.py")
  sh(shell_join([
    "python3", manifest_writer,
    "--archive", archive_path,
    "--output", staged_build_manifest,
    "--git-sha", release_context[:expected_sha],
    "--git-branch", release_context[:expected_branch],
    "--build-timestamp", required_env!("AIES_BUILD_TIMESTAMP"),
    "--xcode-version", required_env!("AIES_XCODE_VERSION"),
    "--swift-version", required_env!("AIES_SWIFT_VERSION"),
    "--sdk-version", required_env!("AIES_SDK_VERSION"),
    "--configuration", "Release",
    "--archive-uuid", required_env!("AIES_ARCHIVE_UUID"),
    "--ipa", ipa_path,
    "--archive-zip", archive_evidence[:archive_zip],
    "--dsym-zip", archive_evidence[:dsym_zip],
    "--github-run-id", required_env!("GITHUB_RUN_ID")
  ]))

  final_paths = [final_ipa, final_signing_report, final_build_manifest]
  FileUtils.rm_f(final_paths)
  begin
    FileUtils.mv(ipa_path, final_ipa)
    FileUtils.mv(staged_signing_report, final_signing_report)
    FileUtils.mv(staged_build_manifest, final_build_manifest)
  rescue StandardError
    FileUtils.rm_f(final_paths)
    raise
  ensure
    FileUtils.rm_rf(staging_directory) if final_paths.all? { |path| File.file?(path) }
  end

  {
    archive_path: archive_path,
    archive_zip: archive_evidence[:archive_zip],
    build_manifest: final_build_manifest,
    dsym_zip: archive_evidence[:dsym_zip],
    ipa_path: final_ipa,
    signing_report: final_signing_report
  }
end

def verify_aies_asc_build!(build, release_context)
  token = Spaceship::ConnectAPI.token
  UI.user_error!("App Store Connect token is unavailable after upload.") if token.nil?
  token.refresh! if token.respond_to?(:refresh!)

  builds = Spaceship::ConnectAPI::Build.all(
    app_id: release_context[:app_store_id],
    version: build[:short_version],
    build_number: build[:build_number],
    platform: Spaceship::ConnectAPI::Platform::IOS,
    processing_states: "PROCESSING,FAILED,INVALID,VALID",
    limit: 2
  )
  unless builds.length == 1
    UI.user_error!(
      "Expected exactly one App Store Connect build for the uploaded app/version/build; " \
      "found #{builds.length}."
    )
  end

  asc_build = builds.first
  exact_identity =
    asc_build.app_id.to_s == release_context[:app_store_id] &&
    asc_build.bundle_id == release_context[:main_bundle_id] &&
    asc_build.app_version == build[:short_version] &&
    asc_build.version == build[:build_number] &&
    asc_build.platform == Spaceship::ConnectAPI::Platform::IOS
  UI.user_error!("App Store Connect returned a mismatched build identity.") unless exact_identity

  response = Spaceship::ConnectAPI.get_build(build_id: asc_build.id, includes: nil)
  body = response.respond_to?(:body) ? response.body : nil
  data = body.is_a?(Hash) ? body["data"] : nil
  attributes = data.is_a?(Hash) ? data["attributes"] : nil
  unless data.is_a?(Hash) && data["id"].to_s == asc_build.id.to_s && attributes.is_a?(Hash)
    UI.user_error!("App Store Connect returned malformed exact-build evidence.")
  end
  processing_state = attributes["processingState"]
  audience_type = attributes["buildAudienceType"]
  UI.user_error!("Uploaded App Store Connect build is not VALID.") unless processing_state == "VALID"
  unless audience_type == "INTERNAL_ONLY"
    UI.user_error!("Uploaded build is not restricted to the INTERNAL_ONLY audience.")
  end

  {
    asc_build_id: asc_build.id.to_s,
    asc_processing_state: processing_state,
    asc_build_audience_type: audience_type
  }
end

def write_aies_delivery_report!(build, release_context, evidence, asc_evidence)
  unless build[:testflight_internal_testing_only] == true
    UI.user_error!("Refusing to report internal-only delivery without the immutable export option.")
  end
  report_path = required_env!("AIES_TESTFLIGHT_RESULT_PATH")
  report = {
    schema: "argus.openclaw-ios.testflight-delivery.v1",
    status: "uploaded_processing_complete",
    uploaded_at: Time.now.utc.iso8601,
    git_sha: release_context[:expected_sha],
    git_branch: release_context[:expected_branch],
    version: build[:short_version],
    build_number: build[:build_number],
    app_bundle_id: release_context[:main_bundle_id],
    app_store_connect_app_id: release_context[:app_store_id],
    distribution: "internal_only",
    testflight_internal_testing_only: true,
    external_distribution_requested: false,
    beta_review_requested: false,
    asc_build_id: asc_evidence[:asc_build_id],
    asc_processing_state: asc_evidence[:asc_processing_state],
    asc_build_audience_type: asc_evidence[:asc_build_audience_type],
    github_run_id: required_env!("GITHUB_RUN_ID"),
    github_run_attempt: required_env!("GITHUB_RUN_ATTEMPT"),
    workflow_run_url: "#{required_env!("GITHUB_SERVER_URL")}/#{required_env!("GITHUB_REPOSITORY")}/actions/runs/#{required_env!("GITHUB_RUN_ID")}",
    processing_wait_timeout_seconds: 3600,
    internal_tester_group: release_context[:internal_group],
    internal_tester_status: "manual_assignment_required",
    manual_action: "Assign this processed build to the named internal group in App Store Connect, then verify Ethan is a member.",
    build_manifest: File.basename(evidence[:build_manifest]),
    signing_report: File.basename(evidence[:signing_report])
  }
  File.write(report_path, JSON.pretty_generate(report) + "\n")
end

platform :ios do
  private_lane :asc_api_key do
    load_env_file(File.join(__dir__, ".env"))
    clear_empty_env_var("APP_STORE_CONNECT_API_KEY_PATH")
    clear_empty_env_var("ASC_KEY_PATH")
    clear_empty_env_var("ASC_KEY_CONTENT")

    api_key = nil

    key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    if env_present?(key_path)
      api_key = app_store_connect_api_key(path: key_path)
    else
      p8_path = ENV["ASC_KEY_PATH"]
      if env_present?(p8_path)
        key_id = ENV["ASC_KEY_ID"]
        issuer_id = ENV["ASC_ISSUER_ID"]
        UI.user_error!("Missing ASC_KEY_ID or ASC_ISSUER_ID for ASC_KEY_PATH auth.") if [key_id, issuer_id].any? { |v| !env_present?(v) }

        api_key = app_store_connect_api_key(
          key_id: key_id,
          issuer_id: issuer_id,
          key_filepath: p8_path
        )
      else
        key_id = ENV["ASC_KEY_ID"]
        issuer_id = ENV["ASC_ISSUER_ID"]
        key_content = ENV["ASC_KEY_CONTENT"]
        key_content = read_asc_key_content_from_keychain unless env_present?(key_content)

        UI.user_error!(
          "Missing App Store Connect API key. Set APP_STORE_CONNECT_API_KEY_PATH (json), ASC_KEY_PATH (p8), or ASC_KEY_ID/ASC_ISSUER_ID with ASC_KEY_CONTENT (or Keychain via ASC_KEYCHAIN_SERVICE/ASC_KEYCHAIN_ACCOUNT)."
        ) if [key_id, issuer_id, key_content].any? { |v| !env_present?(v) }

        is_base64 = key_content.include?("BEGIN PRIVATE KEY") ? false : true

        api_key = app_store_connect_api_key(
          key_id: key_id,
          issuer_id: issuer_id,
          key_content: key_content,
          is_key_content_base64: is_base64
        )
      end
    end

    api_key
  end

  private_lane :prepare_beta_context do |options|
    require_api_key = options[:require_api_key] == true
    needs_api_key = require_api_key || beta_build_number_needs_asc_auth?
    api_key = needs_api_key ? asc_api_key : nil
    sync_ios_versioning!
    version_metadata = read_ios_version_metadata
    version = version_metadata[:version]
    short_version = version_metadata[:short_version]
    build_number = resolve_beta_build_number(
      api_key: api_key,
      short_version: short_version,
      minimum_build_number: options[:minimum_build_number]
    )
    beta_xcconfig = prepare_beta_release!(
      version: version,
      build_number: build_number,
      team_id: options[:team_id],
      push_mode: options[:push_mode]
    )

    {
      api_key: api_key,
      beta_xcconfig: beta_xcconfig,
      build_number: build_number,
      short_version: short_version,
      version: version
    }
  end

  desc "Credential-free regression for the AIES archive/export signing boundary"
  lane :verify_aies_export_command do
    fixture_certificate = "credential-free-development-certificate-fixture".b
    fixture_certificate_sha256 = Digest::SHA256.hexdigest(fixture_certificate)
    remote_profile_type = Spaceship::ConnectAPI::Profile::ProfileType::IOS_APP_DEVELOPMENT
    remote_profile_state = Spaceship::ConnectAPI::Profile::ProfileState::ACTIVE
    remote_profile = Struct.new(
      :id,
      :profile_type,
      :profile_state,
      :uuid,
      :name
    ).new(
      "PROFILEFIXTURE1",
      remote_profile_type,
      remote_profile_state,
      "00000000-0000-0000-0000-000000000001",
      "AIES credential-free development profile fixture"
    )
    parsed_profile = {
      "UUID" => remote_profile.uuid,
      "Name" => remote_profile.name,
      "ExpirationDate" => Time.now.utc + 172_800,
      "TeamIdentifier" => ["TEAMID1234"],
      "ApplicationIdentifierPrefix" => ["TEAMID1234"],
      "Platform" => ["iOS", "xrOS", "visionOS"],
      "Entitlements" => {
        "application-identifier" => "TEAMID1234.#{BETA_APP_IDENTIFIER}",
        "com.apple.developer.team-identifier" => "TEAMID1234",
        "get-task-allow" => true,
        "aps-environment" => "development"
      },
      "ProvisionedDevices" => ["SANITIZED-DEVICE-FIXTURE"],
      "DeveloperCertificates" => [fixture_certificate]
    }
    fixture_release_context = {
      team_id: "TEAMID1234",
      main_bundle_id: BETA_APP_IDENTIFIER
    }
    validated_profile = validate_aies_development_profile!(
      {
        target: "main",
        bundle_id: BETA_APP_IDENTIFIER,
        remote: remote_profile
      },
      parsed_profile,
      fixture_release_context,
      fixture_certificate_sha256
    )
    unless validated_profile[:developer_certificate_sha256] == [fixture_certificate_sha256]
      UI.user_error!("Credential-free development profile validation regression failed.")
    end
    wrong_certificate_rejected = false
    begin
      validate_aies_development_profile!(
        {
          target: "main",
          bundle_id: BETA_APP_IDENTIFIER,
          remote: remote_profile
        },
        parsed_profile.merge("DeveloperCertificates" => ["wrong-certificate".b]),
        fixture_release_context,
        fixture_certificate_sha256
      )
    rescue StandardError
      wrong_certificate_rejected = true
    end
    unless wrong_certificate_rejected
      UI.user_error!("Development profile validator accepted an unrelated certificate.")
    end

    test_auth = aies_xcode_auth_arguments(
      key_path: "/tmp/aies-regression-key.p8",
      key_id: "TESTKEY123",
      issuer_id: "11111111-2222-3333-4444-555555555555"
    )
    context = {
      output_directory: "/tmp/aies-export-regression",
      team_id: "TEAMID1234",
      archive_xcode_arguments: [],
      export_xcode_arguments: test_auth
    }
    Dir.mktmpdir("aies-export-regression") do |directory|
      archive_path = File.join(directory, "OpenClaw.xcarchive")
      output_directory = File.join(directory, "export")
      beta_xcconfig = File.join(directory, "AIES-Beta.xcconfig")
      FileUtils.mkdir_p(output_directory)
      File.write(beta_xcconfig, "// credential-free command-rendering fixture\n")
      test_development_identity = "A" * 40
      archive_context = context.merge(
        beta_xcconfig: beta_xcconfig,
        provenance_arguments: [],
        archive_signing_arguments: [
          "CODE_SIGN_IDENTITY=#{test_development_identity}"
        ]
      )
      archive_options = aies_archive_build_options(archive_context, archive_path)
      Gym.config = FastlaneCore::Configuration.create(
        Gym::Options.available_options,
        archive_options
      )
      Gym.project = FastlaneCore::Project.new(Gym.config)
      Gym.cache.clear
      archive_argv = Shellwords.split(Gym::BuildCommandGenerator.generate.join(" "))
      identity_argument = "CODE_SIGN_IDENTITY=#{test_development_identity}"
      unless archive_argv.count(identity_argument) == 1 && !archive_argv.include?("-exportArchive")
        UI.user_error!("Rendered archive command did not select the exact reusable development identity once.")
      end
      forbidden_archive_arguments = test_auth + ["-allowProvisioningDeviceRegistration"]
      if forbidden_archive_arguments.any? { |argument| archive_argv.include?(argument) }
        UI.user_error!("Rendered archive command retained an Apple provisioning-mutation or authentication argument.")
      end

      FileUtils.mkdir_p(archive_path)
      options = aies_export_build_options(context, archive_path, output_directory)
      UI.user_error!("AIES export must use the canonical xcargs source.") unless options.key?(:xcargs)
      UI.user_error!("AIES export must not use export_xcargs.") if options.key?(:export_xcargs)

      Gym.config = FastlaneCore::Configuration.create(
        Gym::Options.available_options,
        options
      )
      UI.user_error!("Gym did not retain the canonical xcargs source.") unless env_present?(Gym.config[:xcargs])
      UI.user_error!("Gym retained an unexpected export_xcargs source.") if env_present?(Gym.config[:export_xcargs])
      argv = Shellwords.split(Gym::PackageCommandGenerator.generate.join(" "))
      UI.user_error!("Gym regression did not render an export command.") unless argv.include?("-exportArchive")
      if argv.any? { |argument| argument.start_with?("CODE_SIGN_IDENTITY=") } ||
          argv.any? { |argument| argument.include?(test_development_identity) }
        UI.user_error!("Archive-only Apple Development identity contaminated export.")
      end
      unless argv.count("-allowProvisioningUpdates") == 1
        UI.user_error!("Rendered export command must contain -allowProvisioningUpdates exactly once.")
      end
      expected = {
        "-authenticationKeyPath" => "/tmp/aies-regression-key.p8",
        "-authenticationKeyID" => "TESTKEY123",
        "-authenticationKeyIssuerID" => "11111111-2222-3333-4444-555555555555"
      }
      expected.each do |flag, value|
        positions = argv.each_index.select { |index| argv[index] == flag }
        UI.user_error!("Rendered export command must contain #{flag} exactly once.") unless positions.length == 1
        UI.user_error!("Rendered export command has the wrong value for #{flag}.") unless argv[positions.first + 1] == value
      end
      plist_index = argv.index("-exportOptionsPlist")
      UI.user_error!("Rendered export command omitted ExportOptions.plist.") if plist_index.nil?
      plist_path = argv.fetch(plist_index + 1)
      plist = File.read(plist_path)
      unless plist.scan("<key>method</key>").length == 1 &&
             plist.match?(%r{<key>method</key>\s*<string>app-store</string>})
        UI.user_error!("Rendered ExportOptions.plist must contain one Gym-compatible app-store method.")
      end
      unless plist.scan("<key>testFlightInternalTestingOnly</key>").length == 1 &&
             plist.match?(%r{<key>testFlightInternalTestingOnly</key>\s*<true/>})
        UI.user_error!("Rendered ExportOptions.plist must remain internal-TestFlight-only.")
      end
      unless plist.scan("<key>manageAppVersionAndBuildNumber</key>").length == 1 &&
             plist.match?(%r{<key>manageAppVersionAndBuildNumber</key>\s*<false/>})
        UI.user_error!("Rendered ExportOptions.plist must disable Apple-managed build numbering.")
      end
    end

    UI.user_error!("Build-number floor regression failed.") unless monotonic_beta_build_number(
      latest_build: 0,
      minimum_build_number: "51"
    ) == "51"
    UI.user_error!("ASC build-number precedence regression failed.") unless monotonic_beta_build_number(
      latest_build: 72,
      minimum_build_number: "51"
    ) == "73"
    begin
      monotonic_beta_build_number(latest_build: 0, minimum_build_number: "0")
      UI.user_error!("Invalid build-number floor was accepted.")
    rescue ArgumentError
      # Expected: signed release floors are strictly positive integers.
    end
    UI.success("Rendered AIES export command contains each ASC authentication flag exactly once.")
  end

  desc "Build a beta archive locally without uploading"
  lane :beta_archive do
    context = prepare_beta_context(require_api_key: false)
    build = build_beta_release(context)
    UI.success("Built iOS beta archive: version=#{build[:version]} short=#{build[:short_version]} build=#{build[:build_number]}")
    build
  ensure
    ENV.delete("XCODE_XCCONFIG_FILE")
  end

  desc "Build + upload a beta to TestFlight"
  lane :beta do
    context = prepare_beta_context(require_api_key: true)
    build = build_beta_release(context)

    upload_to_testflight(
      api_key: context[:api_key],
      ipa: build[:ipa_path],
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption: false
    )

    UI.success("Uploaded iOS beta: version=#{build[:version]} short=#{build[:short_version]} build=#{build[:build_number]}")
  ensure
    ENV.delete("XCODE_XCCONFIG_FILE")
  end

  desc "Build, verify, and upload an exact-SHA AIES internal TestFlight diagnostic"
  lane :aies_internal_testflight do
    development_keychain_name = nil
    installed_development_profiles = []
    release_context = prepare_aies_internal_context!
    setup_ci
    development_keychain_name = ENV["MATCH_KEYCHAIN_NAME"]
    development_identity = import_aies_reusable_development_identity!(release_context)
    context = prepare_beta_context(
      require_api_key: true,
      minimum_build_number: required_env!("GITHUB_RUN_NUMBER"),
      team_id: release_context[:team_id],
      push_mode: "direct"
    )
    development_profiles = fetch_install_aies_reusable_development_profiles!(
      release_context,
      development_identity.fetch(:certificate_sha256)
    )
    installed_development_profiles = development_profiles.fetch(:installed_paths)
    context[:aies_internal] = true
    context[:archive_signing_arguments] = [
      "CODE_SIGN_IDENTITY=#{development_identity.fetch(:certificate_sha1)}"
    ]
    context[:output_directory] = release_context[:output_directory]
    context[:provenance_arguments] = aies_provenance_arguments(release_context)
    context[:team_id] = release_context[:team_id]
    context[:archive_xcode_arguments] = []
    context[:export_xcode_arguments] = aies_xcode_auth_arguments

    build = build_aies_beta_archive(context)
    archive_evidence = package_aies_archive_evidence!(build, release_context)
    archive_evidence[:development_profile_receipt] = development_profiles.fetch(:receipt)
    verify_aies_reusable_development_identity!(archive_evidence, release_context)
    remove_aies_installed_development_profiles!(installed_development_profiles)
    installed_development_profiles = []
    build = export_aies_beta_archive(context, build)
    evidence = package_aies_internal_evidence!(
      build,
      release_context,
      archive_evidence
    )

    # Internal groups are managed in App Store Connect. Do not pass `groups`,
    # because Fastlane defines that option for external TestFlight distribution.
    upload_to_testflight(
      api_key: context[:api_key],
      ipa: evidence[:ipa_path],
      app_identifier: release_context[:main_bundle_id],
      apple_id: release_context[:app_store_id],
      app_platform: "ios",
      app_version: build[:short_version],
      build_number: build[:build_number],
      skip_submission: false,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false,
      submit_beta_review: false,
      wait_processing_interval: 30,
      wait_processing_timeout_duration: 3600,
      uses_non_exempt_encryption: false
    )

    asc_evidence = verify_aies_asc_build!(build, release_context)
    write_aies_delivery_report!(build, release_context, evidence, asc_evidence)
    UI.success(
      "Uploaded processed AIES internal diagnostic: " \
      "version=#{build[:version]} short=#{build[:short_version]} build=#{build[:build_number]}"
    )
  ensure
    cleanup_errors = []
    begin
      remove_aies_installed_development_profiles!(installed_development_profiles)
    rescue StandardError => e
      cleanup_errors << "development profile cleanup failed (#{e.class})"
    end
    begin
      if env_present?(development_keychain_name)
        expected_keychain_name = ENV["FL_SETUP_CI_KEYCHAIN_NAME"]
        if development_keychain_name == expected_keychain_name &&
            development_keychain_name.match?(/\Aaies_development_[0-9]+_[0-9]+\z/)
          delete_keychain(name: development_keychain_name)
        else
          cleanup_errors << "refused unexpected development keychain"
        end
      end
    rescue StandardError => e
      cleanup_errors << "development keychain cleanup failed (#{e.class})"
    ensure
      ENV.delete("AIES_DEVELOPMENT_CERTIFICATE_PASSWORD")
      ENV.delete("XCODE_XCCONFIG_FILE")
    end
    UI.user_error!(cleanup_errors.join("; ")) unless cleanup_errors.empty?
  end

  desc "Upload App Store metadata (and optionally screenshots)"
  lane :metadata do
    sync_ios_versioning!
    version_metadata = read_ios_version_metadata
    api_key = asc_api_key
    clear_empty_env_var("APP_STORE_CONNECT_API_KEY_PATH")
    app_identifier = ENV["ASC_APP_IDENTIFIER"]
    app_id = ENV["ASC_APP_ID"]
    app_identifier = nil unless env_present?(app_identifier)
    app_id = nil unless env_present?(app_id)

    if screenshot_upload_requested? && screenshot_paths.empty?
      UI.user_error!("DELIVER_SCREENSHOTS=1 but no PNG screenshots were found under apps/ios/fastlane/screenshots.")
    end

    deliver_options = {
      api_key: api_key,
      force: true,
      app_version: version_metadata[:short_version],
      copyright: "2026 OpenClaw",
      primary_category: "PRODUCTIVITY",
      secondary_category: "UTILITIES",
      skip_screenshots: !screenshot_upload_requested?,
      skip_metadata: ENV["DELIVER_METADATA"] != "1",
      skip_binary_upload: true,
      overwrite_screenshots: screenshot_upload_requested?,
      run_precheck_before_submit: false
    }
    deliver_options[:app_identifier] = app_identifier if app_identifier
    if app_id && app_identifier.nil?
      # `deliver` prefers app_identifier from Appfile unless explicitly blanked.
      deliver_options[:app_identifier] = ""
      deliver_options[:app] = app_id
    end

    deliver(**deliver_options)
  end

  desc "Validate App Store Connect API auth"
  lane :auth_check do
    asc_api_key
    UI.success("App Store Connect API auth loaded successfully.")
  end
end
